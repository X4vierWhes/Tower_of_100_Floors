[gd_scene format=3 uid="uid://ddsv16ylr5jgo"]

[sub_resource type="GDScript" id="GDScript_4iw7e"]
script/source = "extends Node2D
class_name UsableItem

@export_category(\"Configurações\")
@export var item_name: String = \"null\"
@export_enum(\"Consumable\", \"Throwable\") var item_type: String
@export var range_distance: float = 1200.0

var group_to_attack: String = \"Enemies\"
var travelled_distance: float = 0.0
var direction: Vector2 = Vector2.ZERO

func _ready() -> void:
	set_process(false)

func _activate_item() -> void:
	match item_type:
		\"Consumable\":
			_apply_consumable_effect()
		\"Throwable\":
			set_process(true)

func _apply_consumable_effect() -> void:
	pass
"

[node name="usable_item" type="Node2D" unique_id=305489136]

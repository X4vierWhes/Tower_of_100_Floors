[sub_resource type="GDScript" id="GDScript_nvn2h"]
resource_name = "map_constructor"
script/source = "extends Room
class_name MapConstructor

const FILE_PATH_ROOMS: String = \"res://Resources/room/room\"

var map_layers: Array[TileMapLayer] = []

func _ready() -> void:
	print(_get_next_room())
	for i in room_principal_layer.get_children():
		map_layers.append(i)
		i.clear()
	#save_map(map_layers)
	load_map(room_id)

func save_map(layers: Array[TileMapLayer]) -> void:
	var map_data: Dictionary = {}
	map_data[\"metadata\"] = {
	\"room_id\": room_id,
	\"next_room\": next_room
	}
	for layer in layers: #Adcionando layers do mapa
		var layer_tiles = []
		for cell in layer.get_used_cells():
			var cell_info = {
				\"pos_x\": cell.x,
				\"pos_y\": cell.y,
				\"source_id\": layer.get_cell_source_id(cell),
				\"atlas_coords_x\": layer.get_cell_atlas_coords(cell).x,
				\"atlas_coords_y\": layer.get_cell_atlas_coords(cell).y,
				\"alt_tile\": layer.get_cell_alternative_tile(cell)
			}
			layer_tiles.append(cell_info)
		map_data[layer.name] = layer_tiles
	
	for enemy in enemies_control.get_children(): #Adcionando inimigos
		var enemy_info = {
			\"scene\": enemy.scene_file_path,
			\"pos_x\": enemy.global_position.x,
			\"pos_y\": enemy.global_position.y
		}
		map_data[\"ENEMY_\" + str(enemy.get_index())] = enemy_info 
	
	var full_path: String = FILE_PATH_ROOMS + room_id + \".json\"
	var file = FileAccess.open(full_path, FileAccess.WRITE)
	
	if file:
		var json_string = JSON.stringify(map_data, \"\\t\")
		file.store_string(json_string)
		file.close()
		print(\"Mapa de múltiplas camadas salvo em: \", full_path)

func load_map(room_to_open_id: String) -> void:
	var full_path: String = FILE_PATH_ROOMS + room_to_open_id + \".json\"
	
	if !FileAccess.file_exists(full_path):
		printerr(\"Arquivo de mapa não encontrado\")
		return
	
	for child in enemies_control.get_children():
		enemies_control._del_enemie(child)
	
	var file = FileAccess.open(full_path, FileAccess.READ)
	var json_data = JSON.parse_string(file.get_as_text())
	file.close()
	
	if json_data == null:
		printerr(\"Erro ao processar JSON.\")
		return
	
	for key in json_data.keys():
		var data = json_data[key]
		
		if key == \"metadata\":
			self.room_id = data[\"room_id\"]
			self.next_room = data[\"next_room\"]
			continue
		
		if data is Array:
			var target_layer = room_principal_layer.get_node_or_null(key) as TileMapLayer
			if target_layer:
				target_layer.clear()
				for cell in data:
					var pos = Vector2i(cell[\"pos_x\"], cell[\"pos_y\"])
					var atlas_coords = Vector2i(cell[\"atlas_coords_x\"], cell[\"atlas_coords_y\"])
					target_layer.set_cell(
						pos, 
						cell[\"source_id\"], 
						atlas_coords, 
						cell[\"alt_tile\"]
					)
			else:
				print(\"Aviso: Layer \", key, \" não encontrada na cena.\")
		if key.begins_with(\"ENEMY_\") and data is Dictionary:
			_spawn_enemy(data)

func _spawn_enemy(enemy_data: Dictionary) -> void:
	var scene_path = enemy_data[\"scene\"]
	var pos = Vector2(enemy_data[\"pos_x\"], enemy_data[\"pos_y\"])
	
	var enemy_scene = load(scene_path)
	if enemy_scene:
		var enemy_instance = enemy_scene.instantiate() as Node2D
		enemies_control.add_child(enemy_instance)
		enemy_instance.global_position = pos
	else:
		printerr(\"Erro ao carregar cena do inimigo: \", scene_path)
"

